{
  "name": "@pinnet/qutie-ticker",
  "version": "0.1.0",
  "license": "MIT",
  "tasks": {
    "start": "deno run --allow-net=api.github.com,127.0.0.1:8080 --allow-env=GITHUB_TOKEN --allow-read=.,/dev/rfcomm0 --allow-write=state.json,/dev/rfcomm0 src/main.ts",
    "dry": "deno run --allow-net=api.github.com,127.0.0.1:8080 --allow-env=GITHUB_TOKEN --allow-read=. --allow-write=. src/main.ts config.dry.json",
    "preview": "deno run --allow-write=preview.pbm,preview.prn src/preview.ts",
    "test": "deno test",
    "check": "deno check src/ tests/ && deno lint && deno fmt --check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": {
    "lineWidth": 120
  }
}
